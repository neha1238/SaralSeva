import requests
import os

BASE_URL = "https://saral.navgurukul.org/api"

def fetch_json(endpoint):
    try:
        response = requests.get(f"{BASE_URL}/{endpoint}")
        response.raise_for_status()
        return response.json()
    except requests.exceptions.RequestException as e:
        print(f"Error: {e}")
        return None

def list_courses():
    data = fetch_json("courses")
    if not data:
        return []
    print("\n📚 Available Courses:")
    for idx, course in enumerate(data["availableCourses"]):
        print(f"{idx + 1}. {course['name']}")
    return data["availableCourses"]

